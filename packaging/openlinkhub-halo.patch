+// SetMouseDpiStage selects the active DPI stage of a mouse and applies it.
+// It returns 1 on success, 2 when the stage does not exist or is the sniper
+// stage, and 0 on any other failure. Like every other change made through
+// the API it runs under the devices mutex.
+func SetMouseDpiStage(deviceId string, stage int) uint8 {
+	mutex.Lock()
+	defer mutex.Unlock()
+
+	entry, ok := devices[deviceId]
+	if !ok || entry.Instance == nil {
+		return 0
+	}
+
+	// Every mouse keeps the active stage in DeviceProfile.Profile and its
+	// stages in DeviceProfile.Profiles, in a type of its own package.
+	instance := reflect.ValueOf(entry.Instance)
+	device := reflect.Indirect(instance)
+	if device.Kind() != reflect.Struct {
+		return 0
+	}
+	profile := device.FieldByName("DeviceProfile")
+	if !profile.IsValid() || (profile.Kind() == reflect.Ptr && profile.IsNil()) {
+		return 0
+	}
+	profile = reflect.Indirect(profile)
+	if profile.Kind() != reflect.Struct {
+		return 0
+	}
+	active := profile.FieldByName("Profile")
+	profiles := profile.FieldByName("Profiles")
+	if !active.IsValid() || !active.CanSet() || active.Kind() != reflect.Int ||
+		!profiles.IsValid() || profiles.Kind() != reflect.Map || profiles.Type().Key().Kind() != reflect.Int {
+		return 0
+	}
+	save := instance.MethodByName("SaveMouseDPI")
+	if !save.IsValid() {
+		return 0
+	}
+
+	wanted := profiles.MapIndex(reflect.ValueOf(stage))
+	if !wanted.IsValid() || wanted.Kind() != reflect.Struct {
+		return 2
+	}
+	if sniper := wanted.FieldByName("Sniper"); sniper.IsValid() && sniper.Kind() == reflect.Bool && sniper.Bool() {
+		return 2
+	}
+
+	// Saving the unchanged stage values stores the profile and applies the
+	// active stage to the mouse.
+	stages := make(map[int]uint16, profiles.Len())
+	iter := profiles.MapRange()
+	for iter.Next() {
+		value := iter.Value().FieldByName("Value")
+		if !value.IsValid() || value.Kind() != reflect.Uint16 {
+			return 0
+		}
+		stages[int(iter.Key().Int())] = uint16(value.Uint())
+	}
+
+	previous := active.Int()
+	active.SetInt(int64(stage))
+	results := save.Call([]reflect.Value{reflect.ValueOf(stages)})
+	if len(results) > 0 && results[0].Uint() == 1 {
+		return 1
+	}
+	active.SetInt(previous)
+	return 0
+}
